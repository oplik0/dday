# Copy to matrix.env and fill in. matrix.env is gitignored — never commit secrets.
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER=@ddaybot:matrix.org
MATRIX_ROOM=!xDJlNwzwWNNdLPbtsK:matrix.org
MATRIX_PASSWORD=
REGISTER_URL=https://dday.hs-ldz.pl/register
# Participant-panel magic link base. Optional: defaults to REGISTER_URL's origin + /panel.
#PANEL_URL=https://dday.hs-ldz.pl/panel
# age SSH ed25519 keypair (gitignored). Generate with: make keys
AGE_PUB=config/dday_ed25519.pub
AGE_KEY=config/dday_ed25519
# End-to-end encryption (the bot reads/answers in encrypted DMs). Pure-Go crypto
# store; keep the DB file and pickle key stable to persist the device + sessions.
# Unset CRYPTO_PICKLE_KEY → an ephemeral one is generated (a restart loses them).
CRYPTO_DB_PATH=crypto.db
#CRYPTO_PICKLE_KEY=
